---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { CATEGORIAS, SITE, NOME, type Categoria } from '../../config';

export async function getStaticPaths() {
  return Object.keys(CATEGORIAS).map((categoria) => ({ params: { categoria } }));
}

const { categoria } = Astro.params;
const cat = categoria as Categoria;
const info = CATEGORIAS[cat];
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.categoria === cat))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout title={info.nome + ' - ' + NOME} description={info.descricao} canonical={SITE + '/' + cat + '/'}>
  <header class="site"><div class="wrap"><a class="logo" href="/">{NOME}</a></div></header>
  <main class="wrap article">
    <h1>{info.nome}</h1>
    <p>{info.descricao}</p>
    <ul class="post-list">
      {posts.map((p) => <li><a href={'/' + cat + '/' + p.id + '/'}><h2>{p.data.title}</h2></a><p>{p.data.description}</p></li>)}
    </ul>
    {posts.length === 0 && <p>Em breve, novos conteúdos.</p>}
  </main>
  <footer class="site"><p>© 2026 {NOME}</p></footer>
</Layout>
